{
  "name": "saizeriya-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "collect:menu": "node scripts/collect-menu.mjs",
    "test:collector": "node --test scripts/parse-menu.test.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "test:quiz": "node --test scripts/quiz.test.mjs",
    "test:gallery": "node --test scripts/gallery.test.mjs",
    "build:pages:develop": "tsc --noEmit && vite build --base=/saizeriya-order/develop/",
    "build:pages:main": "tsc --noEmit && vite build --base=/saizeriya-order/",
    "test:dataset": "node --test scripts/dataset.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
