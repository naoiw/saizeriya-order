{
  "name": "saizeriya-order",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/parse-menu.test.mjs scripts/quiz.test.mjs scripts/gallery.test.mjs scripts/gacha.test.mjs scripts/dataset.test.mjs && node scripts/check-dataset.mjs",
    "collect:menu": "node scripts/collect-menu.mjs",
    "test:collector": "node --test scripts/parse-menu.test.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "test:quiz": "node --test scripts/quiz.test.mjs",
    "test:gallery": "node --test scripts/gallery.test.mjs",
    "test:gacha": "node --test scripts/gacha.test.mjs",
    "test:dataset": "node --test scripts/dataset.test.mjs",
    "build:pages:main": "tsc --noEmit && vite build --base=/saizeriya-order/",
    "build:pages:develop": "tsc --noEmit && vite build --base=/saizeriya-order/develop/"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@9.14.2"
}
